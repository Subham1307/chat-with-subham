# Database
# App runtime: use Neon's pooled connection string (-pooler in hostname)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Migrations: use Neon's direct connection (no -pooler). Optional if DATABASE_URL is pooled —
# prisma.config.ts auto-derives directUrl by stripping "-pooler." from DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://your-app.vercel.app"

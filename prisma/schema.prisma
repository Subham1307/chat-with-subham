// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageStatus {
  SENT
  READ
}

enum Role {
  admin
  mother
  wife
  temp
  friend
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @unique
  createdAt DateTime @default(now())

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  callsMade        Call[]    @relation("CallsMade")
  callsReceived    Call[]    @relation("CallsReceived")

  @@map("users")
}

model Message {
  msgId    String        @id @default(cuid())
  text     String
  status   MessageStatus @default(SENT)
  sentAt   DateTime      @default(now())

  fromId   String
  from     User @relation("SentMessages", fields: [fromId], references: [id])

  toId     String
  to       User @relation("ReceivedMessages", fields: [toId], references: [id])

  @@index([fromId, toId])
  @@index([toId, fromId])
  @@map("messages")
}

enum CallType {
  audio
  video
}

enum CallStatus {
  ringing
  connecting
  rejected
  ended
  missed
  busy
}

model Call {
  id          String     @id @default(cuid())
  callerId    String
  calleeId    String
  type        CallType
  status      CallStatus @default(ringing)
  offerSdp    String?
  answerSdp   String?
  connectedAt DateTime?
  endedAt     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  caller       User              @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User              @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  iceCandidates CallIceCandidate[]

  @@index([callerId, status])
  @@index([calleeId, status])
  @@index([updatedAt])
  @@map("calls")
}

model CallIceCandidate {
  id         String   @id @default(cuid())
  callId     String
  fromUserId String
  candidate  String
  createdAt  DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
  @@map("call_ice_candidates")
}